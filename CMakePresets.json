{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "baseline",
      "displayName": "ML-KEM baseline",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "BUILD_TESTING": "ON",
        "BASELINE_SANITIZERS": "OFF"
      }
    },
    {
      "name": "sanitize",
      "inherits": "baseline",
      "displayName": "ASan and UBSan checks",
      "binaryDir": "${sourceDir}/build/cmake-sanitize",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BASELINE_SANITIZERS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "baseline",
      "configurePreset": "baseline"
    },
    {
      "name": "sanitize",
      "configurePreset": "sanitize"
    }
  ],
  "testPresets": [
    {
      "name": "baseline",
      "configurePreset": "baseline",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "sanitize",
      "configurePreset": "sanitize",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
