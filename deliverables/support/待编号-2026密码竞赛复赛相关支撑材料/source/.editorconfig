root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[Makefile]
indent_style = tab

[*.json]
indent_size = 2

[vendor/**]
trim_trailing_whitespace = false
insert_final_newline = unset

[docs/evidence/**]
trim_trailing_whitespace = false
insert_final_newline = unset

[tests/vectors/**]
trim_trailing_whitespace = false
insert_final_newline = unset
