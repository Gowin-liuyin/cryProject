    361| static int hash_running_executable(uint8_t executable_digest[32])
    362| {
    363|     char executable_path[4096];
    364|     FILE *executable_file;
    365|     struct stat file_status;
    366|     uint8_t *executable_bytes;
    367|     size_t executable_byte_count;
    368|     int operation_status = 0;
    369| #ifdef __APPLE__
    370|     uint32_t executable_path_capacity_bytes = (uint32_t)sizeof(executable_path);
    371|     if (_NSGetExecutablePath(executable_path, &executable_path_capacity_bytes) != 0) {
    372|         return 1;
    373|     }
    374| #else
    375|     ssize_t path_byte_count =
    376|         readlink("/proc/self/exe", executable_path, sizeof(executable_path) - 1u);
    377|     if (path_byte_count < 0 || (size_t)path_byte_count >= sizeof(executable_path) - 1u) {
    378|         return 1;
    379|     }
    380|     executable_path[path_byte_count] = '\0';
    381| #endif
    382|     executable_file = fopen(executable_path, "rb");
    383|     if (executable_file == NULL) {
    384|         return 1;
    385|     }
    386|     if (fstat(fileno(executable_file), &file_status) != 0 || file_status.st_size <= 0 ||
    387|         file_status.st_size > 67108864) {
    388|         (void)fclose(executable_file);
    389|         return 1;
    390|     }
    391|     executable_byte_count = (size_t)file_status.st_size;
    392|     executable_bytes = malloc(executable_byte_count);
    393|     if (executable_bytes == NULL) {
    394|         (void)fclose(executable_file);
    395|         return 1;
    396|     }
    397|     if (fread(executable_bytes, 1, executable_byte_count, executable_file) !=
    398|             executable_byte_count ||
    399|         fgetc(executable_file) != EOF || ferror(executable_file)) {
    400|         operation_status = 1;
    401|     }
    402|     if (fclose(executable_file) != 0) {
    403|         operation_status = 1;
    404|     }
    405|     if (operation_status == 0) {
    406|         measure_sha3_256(executable_digest, executable_bytes, executable_byte_count);
    407|     }
    408|     free(executable_bytes);
    409|     return operation_status;
    410| }
