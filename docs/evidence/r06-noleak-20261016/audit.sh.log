    351|         uint8_t random_bytes[8];
    352|         expand_test_seed(random_bytes, sizeof(random_bytes), test_seed, (*draw_index)++, 4);
    353|         random_value = 0;
    354|         for (unsigned byte_index = 0; byte_index < 8u; ++byte_index) {
    355|             random_value |= (uint64_t)random_bytes[byte_index] << (8u * byte_index);
    356|         }
    357|     } while (random_value < rejection_threshold);
    358|     return random_value % upper_bound;
    359| }
