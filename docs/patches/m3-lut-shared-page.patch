--- a/mlkem/src/compress.c
+++ b/mlkem/src/compress.c
@@ -26,6 +26,39 @@
 #include "debug.h"
 #include "verify.h"
 
+#if PLATFORM_M3_SHARED_LUT
+#include <fcntl.h>
+#include <stdlib.h>
+#include <sys/mman.h>
+#include <unistd.h>
+#define PLATFORM_M3_SHARED_LUT_BYTES 4096u
+static const volatile int16_t *platform_m3_shared_message_bit_table;
+static void platform_m3_shared_lut_initialize(void)
+{
+    const char *shared_lut_path = getenv("PLATFORM_M3_SHARED_LUT_PATH");
+    int shared_lut_descriptor;
+    void *mapped_region;
+    if (shared_lut_path == NULL) {
+        abort();
+    }
+    shared_lut_descriptor = open(shared_lut_path, O_RDONLY);
+    if (shared_lut_descriptor < 0) {
+        abort();
+    }
+    mapped_region = mmap(NULL, PLATFORM_M3_SHARED_LUT_BYTES, PROT_READ, MAP_SHARED,
+        shared_lut_descriptor, 0);
+    (void)close(shared_lut_descriptor);
+    if (mapped_region == MAP_FAILED) {
+        abort();
+    }
+    platform_m3_shared_message_bit_table = (const volatile int16_t *)mapped_region;
+}
+__attribute__((constructor)) static void platform_m3_shared_lut_constructor(void)
+{
+    platform_m3_shared_lut_initialize();
+}
+#endif
